# Select a published release tag from https://github.com/sakuntalle/eFacturaManager/releases.
EFACTURA_VERSION=latest

# Replace this value with a randomly generated password before starting.
POSTGRES_PASSWORD=

# The application binds its ports to this computer only by default.
APP_PUBLIC_URL=https://localhost:8765
APP_TLS_PORT=8765
DATA_DIR=.local/app
APP_SECRETS_DIR=.local/app-secrets
APP_DATABASE_NAME=efactura

# Required only when running the app directly from a source checkout, rather than through Compose.
DATABASE_URL=

# eFactura Manager's ANAF OAuth application registration. Keep these values private and stable.
ANAF_CLIENT_ID=
ANAF_CLIENT_SECRET=
ANAF_REDIRECT_URI=https://localhost:8765/callback
# Native HTTPS app certificate files (Docker mounts .local/tls automatically):
# APP_TLS_CERT_FILE=.local/tls/localhost.pem
# APP_TLS_KEY_FILE=.local/tls/localhost-key.pem

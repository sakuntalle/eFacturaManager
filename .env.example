# Mock ANAF and email transport are independent.
ANAF_MODE=mock
ANAF_ENV=prod
# Original entity and OAuth connection anchor. Add further entities in Settings.
ANAF_CIF=12345678
ANAF_MOCK_URL=http://127.0.0.1:8790

# Local development defaults. Change before sharing/network hosting.
APP_PUBLIC_URL=http://localhost:3100
APP_SESSION_SECRET=local-development-session-secret-change-before-hosting
POSTGRES_PASSWORD=local-development
DATABASE_URL=postgres://efactura:local-development@127.0.0.1:55432/efactura

# Docker default: SMTP to the local Mailpit inbox. Native dev: host=127.0.0.1.
# Replace these with your provider's settings to deliver to your real inbox.
EMAIL_ENABLED=true
EMAIL_FROM="eFactura Manager <invoices@example.test>"
# Initial entity recipient; change per entity in Settings after first startup.
EMAIL_TO=developer@example.test
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
# Provider submission: typically port 587, secure=false, requireTLS=true.
# Implicit TLS submission: port 465, secure=true.

# Deployment-specific OAuth registration. Backend only; ignored in mock mode.
ANAF_CLIENT_ID=
ANAF_CLIENT_SECRET=
ANAF_REDIRECT_URI=https://localhost:8765/callback
ANAF_TLS_CERT_FILE=.local/tls/localhost.pem
ANAF_TLS_KEY_FILE=.local/tls/localhost-key.pem
# Required for live app token encryption: a random 32-byte base64 key.
ANAF_TOKEN_ENCRYPTION_KEY=
# Native HTTPS app (Docker: use compose.https.yaml instead):
# APP_TLS_CERT_FILE=.local/tls/localhost.pem
# APP_TLS_KEY_FILE=.local/tls/localhost-key.pem
# APP_TLS_PORT=8765

# Select a published release tag from https://github.com/sakuntalle/eFacturaManager/releases.
EFACTURA_VERSION=latest

# Replace both values with independent, randomly generated secrets before starting.
POSTGRES_PASSWORD=
APP_SESSION_SECRET=

# The release starts safely in simulator mode and binds all ports to this computer only.
ANAF_MODE=mock
ANAF_ENV=prod
ANAF_CIF=12345678
APP_PUBLIC_URL=http://localhost:3100
APP_DATABASE_NAME=efactura

# Mailpit is included for local notification testing. Set EMAIL_ENABLED=false to skip email jobs.
EMAIL_ENABLED=true
EMAIL_FROM="eFactura Manager <invoices@example.test>"
EMAIL_TO=developer@example.test
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=

# Live ANAF settings are deployment-specific. Keep these values private and stable.
ANAF_CLIENT_ID=
ANAF_CLIENT_SECRET=
ANAF_REDIRECT_URI=https://localhost:8765/callback
ANAF_TOKEN_ENCRYPTION_KEY=
